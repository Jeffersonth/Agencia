# URL pública do site (usada em canonicals, sitemap, Schema e llms.txt)
NEXT_PUBLIC_SITE_URL=https://solunaia.com.br

# Webhook que recebe os leads dos formulários (ex.: n8n, Make, CRM). Opcional.
LEAD_WEBHOOK_URL=

# Leads por e-mail. Com Gmail: SMTP_USER = seu Gmail e SMTP_PASS = senha de app
# (myaccount.google.com/apppasswords, exige verificação em duas etapas), sem espaços.
SMTP_USER=
SMTP_PASS=
# Opcionais: destino (padrão: e-mail de contato do site), servidor (padrão smtp.gmail.com:465) e remetente
LEAD_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=
SMTP_FROM=

# Google Analytics 4 (G-XXXXXXX). Com consentimento de cookies (LGPD).
NEXT_PUBLIC_GA_ID=

# Chave do IndexNow (qualquer string hexadecimal de 8 a 128 caracteres). Depois do deploy: npm run indexnow
INDEXNOW_KEY=

# Verificação de propriedade (método "tag HTML" de cada ferramenta):
# Google Search Console: search.google.com/search-console → Adicionar propriedade → domínio → Tag HTML → copie só o "content"
# Bing Webmaster Tools: bing.com/webmasters → Adicionar site → Verificação manual → Tag Meta → copie só o "content"
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Chat de IA do site (Claude, da Anthropic). Sem a chave, o chat fica desligado.
ANTHROPIC_API_KEY=
# Opcional: modelo (padrão claude-opus-5) e limite de mensagens por dia (padrão 500)
CHAT_MODEL=
CHAT_DAILY_LIMIT=
